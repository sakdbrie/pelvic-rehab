{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    // 1. 删除 "baseUrl": ".",
    "paths": {
      // 2. 在 "src/*" 前加上 "./"
      "@/*": ["./src/*"] 
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}